{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Aegra API",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": ["aegra_api.main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"],
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${env:HOME}/.config/orchestra/.env.backend"
        },
        {
            "name": "Python: Single Test",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests/integration/test_project_routes.py", "-v"],
            "console": "integratedTerminal",
            "justMyCode": true,
            "envFile": "${env:HOME}/.config/orchestra/.env.test"
        },
        {
            "name": "Python: Run Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests/", "-v"],
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${env:HOME}/.config/orchestra/.env.test"
        },
        {
            "name": "Python: Run Unit Tests Only",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests/unit/", "-v"],
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${env:HOME}/.config/orchestra/.env.test"
        },
        {
            "name": "Python: Run Integration Tests Only",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests/integration/", "-v"],
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${env:HOME}/.config/orchestra/.env.test"
        },
        {
            "name": "Python: Remote Attach",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "/app"
                }
            ],
            "justMyCode": true
        }
    ]
}
