FROM python:3.12-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends curl unzip procps && rm -rf /var/lib/apt/lists/*

ENV DENO_INSTALL="/opt/deno"
RUN mkdir -p "${DENO_INSTALL}/bin" && \
    curl -fsSL https://deno.land/install.sh | DENO_INSTALL="${DENO_INSTALL}" sh

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/deno/bin:/app/.venv/bin:$PATH"

WORKDIR /app

COPY pyproject.toml uv.lock* /app/

RUN uv sync --frozen --dev --no-install-project
