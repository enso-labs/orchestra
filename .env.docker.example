# Orchestra Local — Docker Credentials
# Copy to .env.docker and fill in your API keys:
#   make docker.configure
#
# These values are loaded by docker-compose.local.yml
# and override/supplement the defaults in the compose file.

# =============================================================================
# LLM API Keys (at least one required)
# =============================================================================
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# XAI_API_KEY=
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# =============================================================================
# Authentication (optional — defaults provided in compose)
# =============================================================================
# JWT_SECRET_KEY=change-me-in-production
# APP_SECRET_KEY=change-me-in-production

# =============================================================================
# OAuth2 (optional — for GitHub login)
# =============================================================================
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_GITHUB_REDIRECT_URI=http://localhost:8000/auth/callback

# =============================================================================
# Tools (optional)
# =============================================================================
# TAVILY_API_KEY=
# EXA_API_KEY=
