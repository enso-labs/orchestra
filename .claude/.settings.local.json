{
    "hooks": {
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "${HOME}/rusk-ai/orchestra/.claude/hooks/notify_slack.py"
                    }
                ]
            }
        ],
        "Notification": [
            {
                "matcher": "permission_prompt",
                "hooks": [
                    {
                        "type": "command",
                        "command": "${HOME}/rusk-ai/orchestra/.claude/hooks/notify_slack.py"
                    }
                ]
            },
            {
                "matcher": "idle_prompt",
                "hooks": [
                    {
                        "type": "command",
                        "command": "${HOME}/rusk-ai/orchestra/.claude/hooks/notify_slack.py"
                    }
                ]
            }
        ]
    }
}
